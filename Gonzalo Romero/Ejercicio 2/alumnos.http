@url=http://localhost:3000

### Crear alumno (válido)
POST {{url}}/alumnos
Content-Type: application/json

{ "nombre": "Ana", "nota1": 7, "nota2": 8, "nota3": 9 }

### ERROR: duplicado por nombre (case-insensitive)
POST {{url}}/alumnos
Content-Type: application/json

{ "nombre": "ana", "nota1": 6, "nota2": 6, "nota3": 6 }

### Detalle por id (1)
GET {{url}}/alumnos/1

### Reemplazar por id (PUT) - mantener nombre, cambiar notas
PUT {{url}}/alumnos/1
Content-Type: application/json

{ "nombre": "Ana", "nota1": 10, "nota2": 0, "nota3": 10 }

# ---- Errores de rango 0..10 ----

### ERROR: nota > 10
POST {{url}}/alumnos
Content-Type: application/json

{ "nombre": "Bruno", "nota1": 11, "nota2": 7, "nota3": 8 }

### ERROR: nota < 0
POST {{url}}/alumnos
Content-Type: application/json

{ "nombre": "Carla", "nota1": -1, "nota2": 5, "nota3": 6 }
